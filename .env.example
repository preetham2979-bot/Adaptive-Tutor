PORT=3001
JWT_SECRET=replace-with-a-long-random-string
DB_PATH=./server/db/adaptive_tutor.sqlite
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# LLM provider
CLAUDE_MODE=mock
LLM_PROVIDER=mock
GROQ_API_KEY=

# Email — for OTP verification at registration
# How to get a Gmail App Password (takes ~2 minutes):
#   1. Go to myaccount.google.com → Security
#   2. Enable 2-Step Verification if not already on
#   3. Search "App passwords" in the search bar
#   4. Create one → select "Other" → name it "Adaptive Tutor"
#   5. Copy the 16-character password (spaces don't matter)
EMAIL_USER=your.gmail.address@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
